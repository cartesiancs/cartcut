{
  "schema": 1,
  "id": "com.cartcut.cloud.graphic.tally",
  "kind": "graphic",
  "name": "Tally Counter",
  "category": "layout",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1200, "height": 420 },
    "bleed": 40,
    "bindings": { "text": "label", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "target", "label": "Count to", "type": "number", "default": 2026, "min": 0, "max": 999999999, "step": 1 },
    { "key": "countSeconds", "label": "Count for (s)", "type": "number", "default": 2.5, "min": 0.1, "max": 60, "step": 0.1 },
    { "key": "prefix", "label": "Before", "type": "text", "default": "", "maxLength": 20 },
    { "key": "suffix", "label": "After", "type": "text", "default": "+", "maxLength": 20 },
    { "key": "label", "label": "Label", "type": "text", "default": "Frames rendered", "maxLength": 120 },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:Inter-Bold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 200, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    { "key": "accent", "label": "Label colour", "type": "color", "default": "#8fd3ff" }
  ]
}
