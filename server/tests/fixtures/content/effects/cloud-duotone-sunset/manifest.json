{
  "schema": 1,
  "id": "com.cartcut.cloud.duotone-sunset",
  "kind": "effect",
  "name": "Sunset Duotone",
  "category": "color",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "dark",
      "label": "Dark",
      "type": "color",
      "uniform": "dark",
      "default": "#2a0b3d"
    },
    {
      "key": "light",
      "label": "Light",
      "type": "color",
      "uniform": "light",
      "default": "#ff9e5e"
    },
    {
      "key": "contrast",
      "label": "Contrast",
      "type": "number",
      "uniform": "contrast",
      "default": 1.0,
      "min": 0.2,
      "max": 3.0,
      "step": 0.05
    }
  ]
}
