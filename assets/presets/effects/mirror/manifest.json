{
  "schema": 1,
  "id": "com.cartcut.mirror",
  "kind": "effect",
  "name": "Mirror",
  "category": "stylize",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "axis",
      "label": "Reflect",
      "type": "select",
      "uniform": "axis",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Left onto right"
        },
        {
          "value": 1,
          "label": "Right onto left"
        },
        {
          "value": 2,
          "label": "Top onto bottom"
        },
        {
          "value": 3,
          "label": "Bottom onto top"
        }
      ]
    },
    {
      "key": "position",
      "label": "Mirror line",
      "type": "number",
      "uniform": "position",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    }
  ]
}
