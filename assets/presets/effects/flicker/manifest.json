{
  "schema": 1,
  "id": "com.cartcut.flicker",
  "kind": "effect",
  "name": "Flicker",
  "category": "light",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "amount",
      "label": "Amount",
      "type": "number",
      "uniform": "amount",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "rate",
      "label": "Rate (Hz)",
      "type": "number",
      "uniform": "rate",
      "default": 8.0,
      "min": 0.5,
      "max": 40.0,
      "step": 0.5
    },
    {
      "key": "irregularity",
      "label": "Irregularity",
      "type": "number",
      "uniform": "irregularity",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
