{
  "schema": 1,
  "id": "com.cartcut.anamorphic-streak",
  "kind": "effect",
  "name": "Anamorphic Streak",
  "category": "optical",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "combine.frag",
    "passes": [
      {
        "source": "threshold.frag"
      },
      {
        "source": "streak.frag",
        "constants": {
          "reach": 1.0
        }
      },
      {
        "source": "streak.frag",
        "constants": {
          "reach": 5.0
        }
      }
    ]
  },
  "params": [
    {
      "key": "threshold",
      "label": "Threshold",
      "type": "number",
      "uniform": "cutoff",
      "default": 0.8,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "length",
      "label": "Length",
      "type": "number",
      "uniform": "streakLength",
      "default": 40.0,
      "min": 4.0,
      "max": 200.0,
      "step": 2.0
    },
    {
      "key": "amount",
      "label": "Amount",
      "type": "number",
      "uniform": "amount",
      "default": 0.8,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05
    },
    {
      "key": "tint",
      "label": "Tint",
      "type": "color",
      "uniform": "tint",
      "default": "#4a7cff"
    },
    {
      "key": "angle",
      "label": "Angle",
      "type": "number",
      "uniform": "angle",
      "default": 0.0,
      "min": -1.6,
      "max": 1.6,
      "step": 0.05
    }
  ]
}
