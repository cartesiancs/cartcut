{
  "schema": 1,
  "id": "com.cartcut.edge-detect",
  "kind": "effect",
  "name": "Edge Detect",
  "category": "stylize",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "strength",
      "label": "Strength",
      "type": "number",
      "uniform": "strength",
      "default": 1.5,
      "min": 0.0,
      "max": 6.0,
      "step": 0.1
    },
    {
      "key": "threshold",
      "label": "Threshold",
      "type": "number",
      "uniform": "edgeThreshold",
      "default": 0.08,
      "min": 0.0,
      "max": 0.5,
      "step": 0.005
    },
    {
      "key": "overlay",
      "label": "Draw over the picture",
      "type": "bool",
      "uniform": "overlay",
      "default": false
    },
    {
      "key": "line",
      "label": "Line colour",
      "type": "color",
      "uniform": "lineColor",
      "default": "#ffffff"
    }
  ]
}
