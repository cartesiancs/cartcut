{
  "schema": 1,
  "id": "com.cartcut.light-sweep",
  "kind": "effect",
  "name": "Light Sweep",
  "category": "light",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "tint",
      "label": "Colour",
      "type": "color",
      "uniform": "tint",
      "default": "#ffffff"
    },
    {
      "key": "width",
      "label": "Width",
      "type": "number",
      "uniform": "width",
      "default": 0.18,
      "min": 0.02,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "angle",
      "label": "Angle",
      "type": "number",
      "uniform": "angle",
      "default": 0.6,
      "min": -1.6,
      "max": 1.6,
      "step": 0.05
    },
    {
      "key": "period",
      "label": "Period (s)",
      "type": "number",
      "uniform": "period",
      "default": 3.0,
      "min": 0.2,
      "max": 20.0,
      "step": 0.1
    }
  ]
}
