{
  "schema": 1,
  "id": "com.cartcut.motion-blur",
  "kind": "effect",
  "name": "Motion Blur",
  "category": "blur",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "fade.frag",
    "passes": [
      {
        "source": "smear.frag"
      }
    ]
  },
  "params": [
    {
      "key": "length",
      "label": "Length",
      "type": "number",
      "uniform": "blurLength",
      "default": 24.0,
      "min": 0.0,
      "max": 160.0,
      "step": 1.0
    },
    {
      "key": "angle",
      "label": "Angle",
      "type": "number",
      "uniform": "angle",
      "default": 0.0,
      "min": -3.15,
      "max": 3.15,
      "step": 0.05
    }
  ]
}
