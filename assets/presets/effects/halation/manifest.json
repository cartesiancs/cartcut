{
  "schema": 1,
  "id": "com.cartcut.halation",
  "kind": "effect",
  "name": "Halation",
  "category": "optical",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "combine.frag",
    "passes": [
      {
        "source": "threshold.frag"
      },
      {
        "source": "blur.frag",
        "constants": {
          "dir": [
            1,
            0
          ]
        }
      },
      {
        "source": "blur.frag",
        "constants": {
          "dir": [
            0,
            1
          ]
        }
      }
    ]
  },
  "params": [
    {
      "key": "threshold",
      "label": "Threshold",
      "type": "number",
      "uniform": "cutoff",
      "default": 0.7,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "radius",
      "label": "Radius",
      "type": "number",
      "uniform": "radius",
      "default": 20.0,
      "min": 1.0,
      "max": 80.0,
      "step": 1.0
    },
    {
      "key": "amount",
      "label": "Amount",
      "type": "number",
      "uniform": "amount",
      "default": 0.5,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05
    },
    {
      "key": "tint",
      "label": "Tint",
      "type": "color",
      "uniform": "tint",
      "default": "#ff3a1a"
    }
  ]
}
