{
  "schema": 1,
  "id": "com.cartcut.strobe",
  "kind": "effect",
  "name": "Strobe",
  "category": "light",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "rate",
      "label": "Rate (Hz)",
      "type": "number",
      "uniform": "rate",
      "default": 6.0,
      "min": 0.5,
      "max": 30.0,
      "step": 0.5
    },
    {
      "key": "duty",
      "label": "On fraction",
      "type": "number",
      "uniform": "duty",
      "default": 0.5,
      "min": 0.05,
      "max": 0.95,
      "step": 0.01
    },
    {
      "key": "off",
      "label": "Off colour",
      "type": "color",
      "uniform": "offColor",
      "default": "#000000"
    }
  ]
}
