{
  "schema": 1,
  "id": "com.cartcut.threshold",
  "kind": "effect",
  "name": "Threshold",
  "category": "tone",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "level",
      "label": "Level",
      "type": "number",
      "uniform": "level",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "softness",
      "label": "Softness",
      "type": "number",
      "uniform": "softness",
      "default": 0.05,
      "min": 0.0,
      "max": 0.5,
      "step": 0.005
    },
    {
      "key": "dark",
      "label": "Below",
      "type": "color",
      "uniform": "darkColor",
      "default": "#000000"
    },
    {
      "key": "light",
      "label": "Above",
      "type": "color",
      "uniform": "lightColor",
      "default": "#ffffff"
    }
  ]
}
