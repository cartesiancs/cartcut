{
  "schema": 1,
  "id": "com.cartcut.tilt-shift",
  "kind": "effect",
  "name": "Tilt Shift",
  "category": "blur",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "combine.frag",
    "passes": [
      {
        "source": "blur.frag",
        "constants": {
          "dir": [
            1,
            0
          ]
        }
      },
      {
        "source": "blur.frag",
        "constants": {
          "dir": [
            0,
            1
          ]
        }
      }
    ]
  },
  "params": [
    {
      "key": "radius",
      "label": "Radius",
      "type": "number",
      "uniform": "radius",
      "default": 10.0,
      "min": 0.0,
      "max": 60.0,
      "step": 0.5
    },
    {
      "key": "focus",
      "label": "Focus line",
      "type": "number",
      "uniform": "focus",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "depth",
      "label": "In-focus band",
      "type": "number",
      "uniform": "band",
      "default": 0.16,
      "min": 0.0,
      "max": 0.6,
      "step": 0.01
    },
    {
      "key": "falloff",
      "label": "Falloff",
      "type": "number",
      "uniform": "falloff",
      "default": 0.18,
      "min": 0.01,
      "max": 0.6,
      "step": 0.01
    },
    {
      "key": "angle",
      "label": "Tilt",
      "type": "number",
      "uniform": "angle",
      "default": 0.0,
      "min": -1.6,
      "max": 1.6,
      "step": 0.05
    }
  ]
}
