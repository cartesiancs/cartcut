{
  "schema": 1,
  "id": "com.cartcut.lens-distortion",
  "kind": "effect",
  "name": "Lens Distortion",
  "category": "optical",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
