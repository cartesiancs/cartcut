      "min": -1.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "k2",
      "label": "Edge distortion",
      "type": "number",
      "uniform": "k2",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "zoom",
      "label": "Scale",
      "type": "number",
      "uniform": "zoom",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.01
    }
  ]
}
