{
  "schema": 1,
  "id": "com.cartcut.exposure-contrast",
  "kind": "effect",
  "name": "Exposure & Contrast",
  "category": "color",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "exposure",
      "label": "Exposure (stops)",
      "type": "number",
      "uniform": "exposure",
      "default": 0.2,
      "min": -3.0,
      "max": 3.0,
      "step": 0.05
    },
    {
      "key": "contrast",
      "label": "Contrast",
      "type": "number",
      "uniform": "contrast",
      "default": 1.3,
      "min": 0.0,
      "max": 3.0,
      "step": 0.01
    },
    {
      "key": "pivot",
      "label": "Pivot",
      "type": "number",
      "uniform": "pivot",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    }
  ]
}
