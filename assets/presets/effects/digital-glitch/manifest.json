{
  "schema": 1,
  "id": "com.cartcut.digital-glitch",
  "kind": "effect",
  "name": "Digital Glitch",
  "category": "stylize",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "amount",
      "label": "Amount",
      "type": "number",
      "uniform": "amount",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "bands",
      "label": "Bands",
      "type": "number",
      "uniform": "bands",
      "default": 20.0,
      "min": 2.0,
      "max": 90.0,
      "step": 1.0
    },
    {
      "key": "rate",
      "label": "Rate",
      "type": "number",
      "uniform": "rate",
      "default": 8.0,
      "min": 0.5,
      "max": 40.0,
      "step": 0.5
    },
    {
      "key": "split",
      "label": "Channel split",
      "type": "number",
      "uniform": "split",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    }
  ]
}
