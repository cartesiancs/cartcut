{
  "schema": 1,
  "id": "com.cartcut.graphic.typewriter-caret",
  "kind": "graphic",
  "name": "Typewriter Caret",
  "category": "reveal",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 40,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Typing, one letter at a time", "maxLength": 300, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:RobotoMono-Bold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 80, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    { "key": "caret", "label": "Caret", "type": "color", "default": "#4dd0ff" },
    { "key": "interval", "label": "Per letter (ms)", "type": "number", "default": 70, "min": 10, "max": 400, "step": 1 },
    { "key": "blink", "label": "Blink (s)", "type": "number", "default": 1, "min": 0.2, "max": 3, "step": 0.05 }
  ]
}
