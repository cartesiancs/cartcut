{
  "schema": 1,
  "id": "com.cartcut.graphic.ruby-title",
  "kind": "graphic",
  "name": "Ruby Title",
  "category": "layout",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 500 },
    "bleed": 40,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "大韓民國", "maxLength": 60 },
    { "key": "reading", "label": "Reading", "type": "text", "default": "대한민국", "maxLength": 80 },
    { "key": "kicker", "label": "Kicker", "type": "text", "default": "The Reading Above", "maxLength": 80 },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:PlayfairDisplay-Bold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 170, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    { "key": "accent", "label": "Reading colour", "type": "color", "default": "#ffd166" },
    { "key": "ratio", "label": "Reading size", "type": "number", "default": 0.34, "min": 0.15, "max": 0.8, "step": 0.01 }
  ]
}
