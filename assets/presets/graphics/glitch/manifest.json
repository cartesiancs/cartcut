{
  "schema": 1,
  "id": "com.cartcut.graphic.glitch",
  "kind": "graphic",
  "name": "Glitch",
  "category": "distort",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 80,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "GLITCH", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:RobotoMono-Bold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 170, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    { "key": "left", "label": "Left channel", "type": "color", "default": "#ff2a6d" },
    { "key": "right", "label": "Right channel", "type": "color", "default": "#05d9e8" },
    { "key": "amount", "label": "Amount", "type": "number", "default": 1, "min": 0, "max": 3, "step": 0.05 },
    { "key": "period", "label": "Period", "type": "number", "default": 1.6, "min": 0.3, "max": 8, "step": 0.1 },
    { "key": "seed", "label": "Seed", "type": "number", "default": 0, "min": 0, "max": 999, "step": 1 }
  ]
}
