{
  "schema": 1,
  "id": "com.cartcut.graphic.jitter",
  "kind": "graphic",
  "name": "Jitter",
  "category": "distort",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 60,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Hand drawn", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:PermanentMarker-Regular.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 150, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    { "key": "rate", "label": "Boils per second", "type": "number", "default": 8, "min": 1, "max": 24, "step": 1 },
    { "key": "amount", "label": "Amount", "type": "number", "default": 1, "min": 0, "max": 4, "step": 0.05 }
  ]
}
