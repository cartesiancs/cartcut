{
  "schema": 1,
  "id": "com.cartcut.graphic.scatter-in",
  "kind": "graphic",
  "name": "Scatter In",
  "category": "kinetic",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 120,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Scatter", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:ArchivoBlack-Regular.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 170, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    { "key": "distance", "label": "Distance", "type": "number", "default": 700, "min": 0, "max": 2000, "step": 10 },
    { "key": "fly", "label": "Flight (s)", "type": "number", "default": 1.2, "min": 0.2, "max": 4, "step": 0.05 },
    {
      "key": "order",
      "label": "Order",
      "type": "select",
      "default": 0,
      "options": [
        { "value": 0, "label": "Random" },
        { "value": 1, "label": "From the centre" }
      ]
    },
    { "key": "seed", "label": "Seed", "type": "number", "default": 0, "min": 0, "max": 999, "step": 1 }
  ]
}
