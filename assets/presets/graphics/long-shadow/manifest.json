{
  "schema": 1,
  "id": "com.cartcut.graphic.long-shadow",
  "kind": "graphic",
  "name": "Long Shadow",
  "category": "stylized",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 120,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Long Shadow", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:ArchivoBlack-Regular.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 150, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffd23f" },
    { "key": "shadow", "label": "Shadow", "type": "color", "default": "#e4572e" },
    { "key": "direction", "label": "Direction", "type": "number", "default": 45, "min": 0, "max": 360, "step": 1 },
    { "key": "step", "label": "Length", "type": "number", "default": 2, "min": 0.5, "max": 8, "step": 0.1 },
    { "key": "fade", "label": "Fade", "type": "number", "default": 0.6, "min": 0, "max": 1, "step": 0.01 }
  ]
}
