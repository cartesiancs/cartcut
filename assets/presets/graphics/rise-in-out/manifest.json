{
  "schema": 1,
  "id": "com.cartcut.graphic.rise-in-out",
  "kind": "graphic",
  "name": "Rise In and Out",
  "category": "kinetic",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 120,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Rise and fall", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:Oswald-Bold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 160, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#ffffff" },
    { "key": "stagger", "label": "Stagger (ms)", "type": "number", "default": 35, "min": 0, "max": 200, "step": 1 },
    { "key": "distance", "label": "Distance (em)", "type": "number", "default": 0.8, "min": 0, "max": 3, "step": 0.05 }
  ]
}
