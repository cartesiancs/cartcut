{
  "schema": 1,
  "id": "com.cartcut.graphic.highlighter",
  "kind": "graphic",
  "name": "Highlighter",
  "category": "reveal",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 40,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Mark the point", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:Poppins-SemiBold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 120, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Text", "type": "color", "default": "#111111" },
    { "key": "marker", "label": "Marker", "type": "color", "default": "#ffe14d" },
    { "key": "thickness", "label": "Thickness (%)", "type": "number", "default": 88, "min": 10, "max": 100, "step": 1 },
    { "key": "speed", "label": "Sweep (s)", "type": "number", "default": 0.9, "min": 0.2, "max": 4, "step": 0.05 }
  ]
}
