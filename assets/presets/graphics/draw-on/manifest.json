{
  "schema": 1,
  "id": "com.cartcut.graphic.draw-on",
  "kind": "graphic",
  "name": "Draw On",
  "category": "reveal",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 40,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Signature", "maxLength": 60 },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:Caveat-Bold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 220, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Fill", "type": "color", "default": "#ffffff" },
    { "key": "stroke", "label": "Line", "type": "color", "default": "#ffffff" },
    { "key": "weight", "label": "Line width", "type": "number", "default": 3, "min": 0.5, "max": 12, "step": 0.5 },
    { "key": "speed", "label": "Draw (s)", "type": "number", "default": 2.2, "min": 0.3, "max": 8, "step": 0.1 }
  ]
}
