{
  "schema": 1,
  "id": "com.cartcut.graphic.double-outline",
  "kind": "graphic",
  "name": "Double Outline",
  "category": "stylized",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 80,
    "bindings": { "text": "text", "font": "font", "color": "fill", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Outline", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:Montserrat-ExtraBold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 170, "min": 8, "max": 600, "step": 1 },
    { "key": "fill", "label": "Fill", "type": "color", "default": "#ffffff" },
    { "key": "stroke", "label": "Inner outline", "type": "color", "default": "#111111" },
    { "key": "inner", "label": "Inner width", "type": "number", "default": 6, "min": 0, "max": 30, "step": 0.5 },
    { "key": "ring", "label": "Outer ring", "type": "color", "default": "#ff3d6e" }
  ]
}
