{
  "schema": 1,
  "id": "com.cartcut.graphic.lower-third-card",
  "kind": "graphic",
  "name": "Lower Third Card",
  "category": "layout",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1400, "height": 320 },
    "bleed": 40,
    "bindings": { "text": "name", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "name", "label": "Name", "type": "text", "default": "Jane Doe", "maxLength": 80 },
    { "key": "role", "label": "Role", "type": "text", "default": "Director of Photography", "maxLength": 160, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:Poppins-SemiBold.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 76, "min": 8, "max": 300, "step": 1 },
    { "key": "color", "label": "Text", "type": "color", "default": "#ffffff" },
    { "key": "accent", "label": "Bar", "type": "color", "default": "#ff4d4d" },
    { "key": "panel", "label": "Panel", "type": "color", "default": "#101418" },
    { "key": "opacity", "label": "Panel opacity", "type": "number", "default": 0.82, "min": 0, "max": 1, "step": 0.01 }
  ]
}
