{
  "schema": 1,
  "id": "com.cartcut.graphic.light-leak",
  "kind": "graphic",
  "name": "Light Leak",
  "category": "background",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "main.frag"
