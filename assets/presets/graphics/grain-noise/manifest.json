{
  "schema": 1,
  "id": "com.cartcut.graphic.grain-noise",
  "kind": "graphic",
  "name": "Grain Noise",
  "category": "background",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "main.frag"
  },
  "params": [
    { "key": "base", "label": "Base", "type": "color", "uniform": "base", "default": "#1b1d22" },
    { "key": "amount", "label": "Amount", "type": "number", "uniform": "amount", "default": 0.25, "min": 0, "max": 1, "step": 0.01 },
    { "key": "grain", "label": "Grain size", "type": "number", "uniform": "grain", "default": 1.5, "min": 1, "max": 8, "step": 0.1 },
    { "key": "rate", "label": "Changes per second", "type": "number", "uniform": "rate", "default": 24, "min": 1, "max": 60, "step": 1 },
    { "key": "cover", "label": "Cover", "type": "number", "uniform": "cover", "default": 1, "min": 0, "max": 1, "step": 0.01 }
  ]
}
