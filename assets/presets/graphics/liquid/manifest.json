{
  "schema": 1,
  "id": "com.cartcut.graphic.liquid",
  "kind": "graphic",
  "name": "Liquid",
  "category": "distort",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "html",
    "source": "index.html",
    "styles": ["style.css"],
    "layout": "scale",
    "designSize": { "width": 1600, "height": 400 },
    "bleed": 80,
    "bindings": { "text": "text", "font": "font", "color": "color", "fontSize": "size" }
  },
  "params": [
    { "key": "text", "label": "Text", "type": "text", "default": "Liquid", "maxLength": 200, "multiline": true },
    { "key": "font", "label": "Font", "type": "font", "default": "bundled:Lobster-Regular.ttf" },
    { "key": "size", "label": "Size", "type": "number", "default": 180, "min": 8, "max": 600, "step": 1 },
    { "key": "color", "label": "Colour", "type": "color", "default": "#7fdcff" },
    { "key": "amount", "label": "Amount", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.01 }
  ]
}
