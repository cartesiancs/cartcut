{
  "schema": 1,
  "id": "com.cartcut.cube-rotate",
  "kind": "transition",
  "name": "Cube Rotate",
  "category": "3d",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag",
    "vertex": "shader.vert",
    "mesh": {
      "kind": "cube"
    }
  },
  "params": [
    {
      "key": "direction",
      "label": "Direction",
      "type": "select",
      "uniform": "direction",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Left"
        },
        {
          "value": 1,
          "label": "Right"
        },
        {
          "value": 2,
          "label": "Up"
        },
        {
          "value": 3,
          "label": "Down"
        }
      ]
    },
    {
      "key": "shade",
      "label": "Face shading",
      "type": "number",
      "uniform": "shade",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
