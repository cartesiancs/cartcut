{
  "schema": 1,
  "id": "com.cartcut.card-flip",
  "kind": "transition",
  "name": "Card Flip",
  "category": "3d",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag",
    "vertex": "shader.vert"
  },
  "params": [
    {
      "key": "vertical",
      "label": "Vertical",
      "type": "bool",
      "uniform": "vertical",
      "default": false
    },
    {
      "key": "shade",
      "label": "Edge shading",
      "type": "number",
      "uniform": "shade",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
