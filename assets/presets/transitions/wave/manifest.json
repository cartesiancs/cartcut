{
  "schema": 1,
  "id": "com.cartcut.wave",
  "kind": "transition",
  "name": "Wave",
  "category": "distort",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "vertical",
      "label": "Vertical",
      "type": "bool",
      "uniform": "vertical",
      "default": false
    },
    {
      "key": "amplitude",
      "label": "Amplitude",
      "type": "number",
      "uniform": "amplitude",
      "default": 0.06,
      "min": 0.0,
      "max": 0.4,
      "step": 0.005
    },
    {
      "key": "frequency",
      "label": "Frequency",
      "type": "number",
      "uniform": "frequency",
      "default": 6.0,
      "min": 1.0,
      "max": 30.0,
      "step": 0.5
    }
  ]
}
