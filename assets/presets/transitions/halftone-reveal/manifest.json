{
  "schema": 1,
  "id": "com.cartcut.halftone-reveal",
  "kind": "transition",
  "name": "Halftone Reveal",
  "category": "pattern",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "dots",
      "label": "Dots across",
      "type": "number",
      "uniform": "dots",
      "default": 34.0,
      "min": 4.0,
      "max": 120.0,
      "step": 1.0
    },
    {
      "key": "softness",
      "label": "Edge softness",
      "type": "number",
      "uniform": "softness",
      "default": 0.15,
      "min": 0.0,
      "max": 0.6,
      "step": 0.01
    }
  ]
}
