{
  "schema": 1,
  "id": "com.cartcut.blinds",
  "kind": "transition",
  "name": "Blinds",
  "category": "wipe",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "count",
      "label": "Slats",
      "type": "number",
      "uniform": "count",
      "default": 12.0,
      "min": 2.0,
      "max": 60.0,
      "step": 1.0
    },
    {
      "key": "vertical",
      "label": "Vertical",
      "type": "bool",
      "uniform": "vertical",
      "default": false
    },
    {
      "key": "softness",
      "label": "Edge softness",
      "type": "number",
      "uniform": "softness",
      "default": 0.05,
      "min": 0.0,
      "max": 0.5,
      "step": 0.01
    }
  ]
}
