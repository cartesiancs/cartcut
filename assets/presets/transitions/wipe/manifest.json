{
  "schema": 1,
  "id": "com.cartcut.wipe",
  "kind": "transition",
  "name": "Wipe",
  "category": "wipe",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "direction",
      "label": "Direction",
      "type": "select",
      "uniform": "direction",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Left to right"
        },
        {
          "value": 1,
          "label": "Right to left"
        },
        {
          "value": 2,
          "label": "Top to bottom"
        },
        {
          "value": 3,
          "label": "Bottom to top"
        }
      ]
    },
    {
      "key": "softness",
      "label": "Edge softness",
      "type": "number",
      "uniform": "softness",
      "default": 0.03,
      "min": 0.0,
      "max": 0.5,
      "step": 0.01
    }
  ]
}
