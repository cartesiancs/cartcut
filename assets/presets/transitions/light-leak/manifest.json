{
  "schema": 1,
  "id": "com.cartcut.light-leak",
  "kind": "transition",
  "name": "Light Leak",
  "category": "light",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "tint",
      "label": "Colour",
      "type": "color",
      "uniform": "tint",
      "default": "#ff9a3c"
    },
    {
      "key": "direction",
      "label": "From",
      "type": "select",
      "uniform": "direction",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Left"
        },
        {
          "value": 1,
          "label": "Right"
        },
        {
          "value": 2,
          "label": "Top"
        },
        {
          "value": 3,
          "label": "Bottom"
        }
      ]
    },
    {
      "key": "softness",
      "label": "Softness",
      "type": "number",
      "uniform": "softness",
      "default": 0.5,
      "min": 0.05,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
