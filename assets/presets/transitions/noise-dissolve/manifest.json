{
  "schema": 1,
  "id": "com.cartcut.noise-dissolve",
  "kind": "transition",
  "name": "Noise Dissolve",
  "category": "pattern",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
