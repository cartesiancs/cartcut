{
  "schema": 1,
  "id": "com.cartcut.slide",
  "kind": "transition",
  "name": "Slide",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": { "type": "shader", "source": "shader.frag" },
  "params": [
    {
      "key": "direction",
      "label": "Direction",
      "type": "select",
      "uniform": "direction",
      "default": 0,
      "options": [
        { "value": 0, "label": "Left" },
        { "value": 1, "label": "Right" },
        { "value": 2, "label": "Up" },
        { "value": 3, "label": "Down" }
      ]
    }
  ]
}
