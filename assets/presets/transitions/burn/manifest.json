{
  "schema": 1,
  "id": "com.cartcut.burn",
  "kind": "transition",
  "name": "Burn",
  "category": "light",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "ember",
      "label": "Ember",
      "type": "color",
      "uniform": "ember",
      "default": "#ff6a1a"
    },
    {
      "key": "scale",
      "label": "Grain",
      "type": "number",
      "uniform": "scale",
      "default": 5.0,
      "min": 1.0,
      "max": 24.0,
      "step": 0.5
    },
    {
      "key": "width",
      "label": "Edge width",
      "type": "number",
      "uniform": "width",
      "default": 0.12,
      "min": 0.02,
      "max": 0.4,
      "step": 0.01
    }
  ]
}
