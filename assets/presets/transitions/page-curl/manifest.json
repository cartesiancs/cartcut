{
  "schema": 1,
  "id": "com.cartcut.page-curl",
  "kind": "transition",
  "name": "Page Curl",
  "category": "3d",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "radius",
      "label": "Curl radius",
      "type": "number",
      "uniform": "radius",
      "default": 0.28,
      "min": 0.03,
      "max": 0.6,
      "step": 0.01
    },
    {
      "key": "shade",
      "label": "Shading",
      "type": "number",
      "uniform": "shade",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
