{
  "schema": 1,
  "id": "com.cartcut.whip-pan",
  "kind": "transition",
  "name": "Whip Pan",
  "category": "zoom",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "direction",
      "label": "Direction",
      "type": "select",
      "uniform": "direction",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Horizontal"
        },
        {
          "value": 1,
          "label": "Vertical"
        }
      ]
    },
    {
      "key": "strength",
      "label": "Smear",
      "type": "number",
      "uniform": "strength",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
