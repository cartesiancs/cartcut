{
  "schema": 1,
  "id": "com.cartcut.flash",
  "kind": "transition",
  "name": "Flash",
  "category": "light",
  "author": "Cartcut",
  "version": "1.0.0",
  "render": {
    "type": "shader",
    "source": "shader.frag"
  },
  "params": [
    {
      "key": "tint",
      "label": "Colour",
      "type": "color",
      "uniform": "tint",
      "default": "#ffffff"
    },
    {
      "key": "strength",
      "label": "Strength",
      "type": "number",
      "uniform": "strength",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05
    }
  ]
}
