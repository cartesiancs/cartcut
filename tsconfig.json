{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./main",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@nugget/preview-engine": ["packages/preview-engine/src/index.ts"],
      "@nugget/preview-engine/*": ["packages/preview-engine/src/*"]
    }
  },
  "exclude": [
    "./node_modules",
    "packages",
    "main",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
