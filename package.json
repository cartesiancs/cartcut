{
  "name": "cartcut-app",
  "version": "0.5.1",
  "description": "Video Editor",
  "main": "main/main.js",
  "author": "cartesiancs",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run compile\" \"npm run bundle:src\"",
    "compile": "tsc -w -p ./.tsconfig",
    "bundle": "npm run bundle:src",
    "bundle:src": "webpack --mode=development --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e:fixtures": "node tests/e2e/fixtures/fetch.mjs",
    "test:e2e:check": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts --project=full",
    "test:e2e:smoke": "playwright test -c tests/e2e/playwright.config.ts --project=smoke",
    "test:e2e:smoke120": "playwright test -c tests/e2e/playwright.config.ts --project=smoke120",
    "test:e2e:extreme": "playwright test -c tests/e2e/playwright.config.ts --project=extreme",
    "bundle:prod:src": "webpack --mode=production",
    "build:main": "tsc -p ./.tsconfig",
    "build:osx": "npm run build:main && npm run bundle:prod:src && electron-builder build --mac --arm64 --x64 -p always",
    "build:win": "npm run build:main && npm run bundle:prod:src && electron-builder build --win --x64 -p always",
    "build": "npm run build:osx && npm run build:win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cartesiancs/cartcut"
  },
  "build": {
    "productName": "Cartcut",
    "appId": "com.cartesiancs.cartcut",
    "asar": true,
    "extraResources": [
      {
        "from": "./assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./bin/${platform}-${arch}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./bin",
        "to": "bin",
        "filter": [
          "yt-dlp",
          "yt-dlp.exe"
        ]
      }
    ],
    "protocols": {
      "name": "cartcutapp",
      "schemes": [
        "cartcutapp"
      ]
    },
    "mac": {
      "publish": {
        "provider": "github",
        "owner": "cartesiancs",
        "repo": "cartcut"
      },
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/mac/icon.icns",
      "asarUnpack": "**/*.node",
      "notarize": true
    },
    "dmg": {},
    "win": {
      "verifyUpdateCodeSignature": true,
      "publish": {
        "provider": "github",
        "owner": "cartesiancs",
        "repo": "cartcut"
      },
      "target": [
        "nsis"
      ],
      "icon": "./assets/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "buildResources": "./assets/",
      "output": "./dist/",
      "app": "."
    },
    "files": [
      "!src/**/*",
      "!electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "cartesiancs"
    }
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@lit/context": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.3.2",
    "body-parser": "^1.20.3",
    "bootstrap": "^5.0.2",
    "decompress": "4.2.1",
    "decompress-zip": "0.3.3",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^4.4.8",
    "electron-progressbar": "^2.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.0",
    "get-system-fonts": "^2.0.2",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.1",
    "lit": "^3.2.1",
    "lodash": "^4.17.21",
    "path": "^0.12.7",
    "request": "^2.88.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^9.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/preset-env": "^7.22.4",
    "@napi-rs/canvas": "^1.0.2",
    "@playwright/test": "^1.62.1",
    "babel-loader": "^9.1.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint-config-airbnb": "^19.0.4",
    "mini-css-extract-plugin": "^2.6.1",
    "playwright": "^1.62.1",
    "sass": "^1.55.0",
    "sass-loader": "^13.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
